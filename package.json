{
  "name": "openrows",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write '{apps,packages}/**/*.{ts,tsx,css,json,html}' '*.{json,ts,mjs,yaml}' .github/workflows/ci.yml",
    "format:check": "prettier --check '{apps,packages}/**/*.{ts,tsx,css,json,html}' '*.{json,ts,mjs,yaml}' .github/workflows/ci.yml",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "knip": "knip",
    "tauri": "pnpm --filter @openrows/desktop tauri",
    "build": "pnpm --filter @openrows/desktop build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^28.0.0",
    "knip": "^5.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
