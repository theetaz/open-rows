# Homebrew cask template for the maintainer's tap (docs/16 §8, "How to cut a release").
# Replace every @PLACEHOLDER@ before publishing:
#   @VERSION@        release version without the leading "v", e.g. 0.2.0
#   @REPOSITORY@     GitHub owner/name that hosts the releases
#   @SHA256_ARM64@   `shasum -a 256 OpenRows_aarch64.dmg` of the final stapled DMG
#   @SHA256_X86_64@  `shasum -a 256 OpenRows_x86_64.dmg` of the final stapled DMG
cask "openrows" do
  arch arm: "aarch64", intel: "x86_64"

  version "@VERSION@"
  sha256 arm:   "@SHA256_ARM64@",
         intel: "@SHA256_X86_64@"

  url "https://github.com/@REPOSITORY@/releases/download/v#{version}/OpenRows_#{arch}.dmg"
  name "OpenRows"
  desc "Open database client"
  homepage "https://github.com/@REPOSITORY@"

  depends_on macos: ">= :monterey"

  app "OpenRows.app"

  # Package-manager users turn off Settings > General > Update notifications
  # and upgrade with `brew upgrade --cask openrows`.
  zap trash: [
    "~/Library/Application Support/com.prabhavalabs.openrows",
    "~/Library/Caches/com.prabhavalabs.openrows",
    "~/Library/Logs/com.prabhavalabs.openrows",
    "~/Library/Preferences/com.prabhavalabs.openrows.plist",
    "~/Library/Saved Application State/com.prabhavalabs.openrows.savedState",
    "~/Library/WebKit/com.prabhavalabs.openrows",
  ]
end
