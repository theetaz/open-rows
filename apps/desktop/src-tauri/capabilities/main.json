{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: first-render event, window dragging, metadata, result tiles and opt-in IPC spike.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-emit-to",
    "core:window:allow-start-dragging",
    "allow-app-info",
    "allow-result-window",
    "allow-spike-finish",
    "allow-spike-start",
    "allow-spike-progress"
  ]
}
