    "allow-profile-get",
    "allow-profile-create",
    "allow-profile-update",
    "allow-profile-duplicate",
    "allow-profile-delete",
    "allow-profile-parse-url",
    "allow-connection-test",
    "allow-connection-pick-file",
    "allow-ssh-prompt-answer",
    "allow-session-open",
    "allow-session-close",
    "allow-catalog-databases",
    "allow-catalog-schemas",
    "allow-catalog-objects",
    "allow-catalog-search",
    "allow-connection-open",
    "allow-connection-close",
    "allow-query-execute",
