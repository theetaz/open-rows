{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenRows settings",
  "description": "settings.json in the OpenRows app data folder. OpenRows validates every field on load and keeps the default for anything missing or invalid; edits made while the app runs apply within a second.",
  "type": "object",
  "required": ["openrows"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema, for editors."
    },
    "openrows": {
      "const": 1,
      "description": "File format version."
    },
    "theme": {
      "enum": ["system", "light", "dark"],
      "default": "system",
      "description": "Color scheme: follow the system, or always light or dark."
    },
    "general": {
      "type": "object",
      "description": "Settings ▸ General.",
      "properties": {
        "restoreSession": {
          "type": "boolean",
          "description": "Reopen the previous connections, databases and tabs on launch.",
          "default": true
        },
        "density": {
          "enum": ["compact", "regular", "comfortable"],
          "default": "regular",
          "description": "Row height of the sidebar's object tree and lists."
        },
        "gridDensity": {
          "enum": ["compact", "normal", "comfortable"],
          "default": "normal",
          "description": "Row height of table and query result grids."
        },
        "reduceMotion": {
          "type": "boolean",
          "description": "Turn off panel, popover and disclosure animations even when the system allows them.",
          "default": false
        },
        "keepaliveSeconds": {
          "enum": [0, 15, 30, 60, 120],
          "default": 30,
          "description": "Seconds between checks of idle connections; 0 turns them off."
        },
        "statementTimeoutSeconds": {
          "enum": [0, 30, 60, 300, 900, 3600],
          "default": 0,
          "description": "Seconds a statement may run before it is cancelled, for connections that do not set their own limit; 0 means no limit."
        }
      }
    },
    "appearance": {
      "type": "object",
      "description": "Settings ▸ Appearance.",
      "properties": {
        "lightTheme": {
          "type": "string",
          "default": "openrows",
          "description": "Theme in light mode: openrows, graphite, ocean, forest, ember, iris or a custom theme id."
        },
        "darkTheme": {
          "type": "string",
          "default": "openrows",
          "description": "Theme in dark mode: openrows, graphite, ocean, forest, ember, iris or a custom theme id."
        },
        "contrast": {
          "type": "integer",
          "minimum": 80,
          "maximum": 150,
          "default": 100,
          "description": "Contrast in percent."
        },
        "opacity": {
          "type": "integer",
          "minimum": 50,
          "maximum": 100,
          "default": 95,
          "description": "Glass opacity in percent."
        },
        "motion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 400,
          "default": 0,
          "description": "Sidebar open and close animation in milliseconds; 0 is instant."
        },
        "changeColors": {
          "enum": ["red-green", "blue-orange"],
          "default": "red-green",
          "description": "Colors that distinguish inserted and deleted rows."
        },
        "uiFont": {
          "enum": ["system", "helvetica", "arial", "verdana"],
          "default": "system",
          "description": "Interface font."
        },
        "monoFont": {
          "enum": ["system", "menlo", "consolas", "courier"],
          "default": "system",
          "description": "Monospace font of the editor and grid."
        },
        "uiSize": {
          "type": "integer",
          "minimum": 11,
          "maximum": 18,
          "default": 13,
          "description": "Interface font size in points."
        },
        "monoSize": {
          "type": "integer",
          "minimum": 11,
          "maximum": 18,
          "default": 12,
          "description": "Monospace font size in points."
        },
        "customThemes": {
          "type": "array",
          "maxItems": 24,
          "description": "Imported and edited themes.",
          "items": {
            "$ref": "#/definitions/theme"
          }
        }
      }
    },
    "editor": {
      "type": "object",
      "description": "Settings ▸ Editor.",
      "properties": {
        "fontSize": {
          "enum": [null, 11, 12, 13, 14, 15, 16, 18, 20, 24],
          "default": null,
          "description": "Editor font size; null uses the appearance size."
        },
        "invisibles": {
          "type": "boolean",
          "description": "Show spaces and tabs.",
          "default": false
        },
        "wrap": {
          "type": "boolean",
          "description": "Wrap long lines.",
          "default": false
        },
        "highlightQuery": {
          "type": "boolean",
          "description": "Highlight the statement at the cursor.",
          "default": false
        },
        "autocomplete": {
          "type": "boolean",
          "description": "Suggest keywords and schema names while typing.",
          "default": true
        },
        "upperKeywords": {
          "type": "boolean",
          "description": "Complete keywords in upper case.",
          "default": true
        },
        "keyBinding": {
          "enum": ["default", "vim"],
          "default": "default",
          "description": "Editor key bindings."
        },
        "rowLimit": {
          "enum": [null, 100, 500, 1000, 5000, 10000, 50000, 100000, 500000],
          "default": null,
          "description": "Rows kept per result set; null is no limit."
        },
        "indentWidth": {
          "enum": [2, 4],
          "default": 2,
          "description": "Beautify indent width."
        },
        "indentWith": {
          "enum": ["spaces", "tabs"],
          "default": "spaces",
          "description": "Beautify indents with spaces or tabs."
        },
        "keywordCase": {
          "enum": ["preserve", "upper", "lower"],
          "default": "upper",
          "description": "Beautify keyword case."
        },
        "indentStyle": {
          "enum": ["standard", "tabularLeft", "tabularRight"],
          "default": "standard",
          "description": "Beautify layout."
        },
        "linesBetweenQueries": {
          "enum": [1, 2, 3],
          "default": 1,
          "description": "Beautify: empty lines between statements."
        },
        "denseOperators": {
          "type": "boolean",
          "description": "Beautify: write operators without surrounding spaces (a=1).",
          "default": false
        },
        "autoSave": {
          "type": "boolean",
          "description": "Keep query tab text and bound files saved as you type.",
          "default": true
        },
        "queryParams": {
          "enum": ["off", "named", "numbered", "anonymous"],
          "default": "off",
          "description": "Placeholder style listed in the parameters bar and bound when running."
        },
        "resultView": {
          "enum": ["tabs", "last"],
          "default": "tabs",
          "description": "One result tab per statement, or only the last result."
        },
        "returnOnError": {
          "type": "boolean",
          "description": "Stop a multi-statement run at the first error.",
          "default": true
        },
        "runDefault": {
          "enum": ["current", "all"],
          "default": "current",
          "description": "What the Run button and ⌘↵ run."
        },
        "fontFamily": {
          "enum": [
            null,
            "SF Mono",
            "Menlo",
            "Monaco",
            "JetBrains Mono",
            "Fira Code",
            "Source Code Pro",
            "Courier New"
          ],
          "default": null,
          "description": "Editor font; null uses the appearance's monospace font."
        },
        "lineNumbers": {
          "type": "boolean",
          "description": "Show line numbers.",
          "default": true
        },
        "folding": {
          "type": "boolean",
          "description": "Fold statements, comments and bracketed blocks from the gutter.",
          "default": true
        },
        "completionDelay": {
          "enum": [0, 100, 250, 500, 1000],
          "default": 100,
          "description": "Milliseconds after typing before suggestions open."
        },
        "completeSchemas": {
          "type": "boolean",
          "description": "Suggest schema names.",
          "default": true
        },
        "completeTables": {
          "type": "boolean",
          "description": "Suggest tables and views.",
          "default": true
        },
        "completeColumns": {
          "type": "boolean",
          "description": "Suggest columns.",
          "default": true
        },
        "completeSnippets": {
          "type": "boolean",
          "description": "Offer snippets by prefix while typing.",
          "default": true
        }
      }
    },
    "execution": {
      "type": "object",
      "description": "Settings ▸ Execution: how runs start.",
      "properties": {
        "runSelection": {
          "type": "boolean",
          "description": "⌘↵ with text selected runs exactly the selection.",
          "default": true
        },
        "autoLimit": {
          "enum": [null, 100, 200, 500, 1000, 5000, 10000],
          "default": null,
          "description": "Append LIMIT n to SELECT statements without a limit; null runs them as written."
        },
        "confirmMultiple": {
          "type": "boolean",
          "description": "Ask before running more than one statement.",
          "default": false
        },
        "showNotices": {
          "type": "boolean",
          "description": "List server notices and warnings with the results.",
          "default": true
        }
      }
    },
    "shortcuts": {
      "type": "object",
      "description": "Rebound shortcuts by command id; null removes a default shortcut.",
      "propertyNames": {
        "enum": [
          "sidebar",
          "inspector",
          "new-tab",
          "close-tab",
          "database",
          "quick",
          "commands",
          "refresh",
          "run-current",
          "run-all",
          "run-no-limit",
          "cancel",
          "explain",
          "explain-analyze",
          "beautify",
          "uglify",
          "insert-snippet",
          "open-file",
          "run-sql-file",
          "save",
          "save-as",
          "open-project",
          "close-project",
          "split-right",
          "split-down",
          "focus-pane",
          "close-split",
          "export-table",
          "import-data",
          "export-tables",
          "backup-database",
          "restore-database",
          "show-er-diagram",
          "show-jobs",
          "export-results",
          "commit-changes",
          "discard-changes",
          "insert-row",
          "delete-row",
          "copy-selection",
          "copy-as-csv",
          "copy-as-json",
          "copy-as-markdown",
          "copy-as-insert",
          "copy-as-where-in",
          "copy-with-headers",
          "pin-column",
          "reset-columns",
          "focus-filter",
          "toggle-columns",
          "toggle-row-form",
          "open-foreign-key",
          "export-connections",
          "import-connections",
          "new-connection",
          "connect",
          "disconnect",
          "safe",
          "search",
          "schema",
          "processes",
          "new-table",
          "new-view",
          "new-materialized-view",
          "new-function",
          "new-procedure",
          "new-trigger",
          "rename-table",
          "duplicate-table",
          "truncate-table",
          "drop-table",
          "edit-view",
          "drop-view",
          "new-database",
          "rename-database",
          "drop-database",
          "new-schema",
          "rename-schema",
          "drop-schema",
          "settings",
          "shortcuts",
          "help-search",
          "open-logs",
          "theme-light",
          "theme-dark",
          "theme-system",
          "grid-compact",
          "grid-normal",
          "grid-comfortable",
          "gallery"
        ]
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "pattern": "^((Ctrl|Alt|Shift|Cmd)\\+)*([A-Z0-9]|Enter|Comma|Period|Slash|Backslash|BracketLeft|BracketRight|Semicolon|Quote|Minus|Equal|Backquote|Backspace|Delete|Escape|Tab|Space|ArrowUp|ArrowDown|ArrowLeft|ArrowRight|F([1-9]|1[0-2]))$"
          }
        ]
      }
    },
    "diagnostics": {
      "type": "object",
      "description": "Settings ▸ Diagnostics.",
      "properties": {
        "logLevel": {
          "enum": ["error", "warn", "info", "debug", "trace"],
          "default": "info",
          "description": "What the log file records; applies at the next launch."
        },
        "crashReports": {
          "type": "boolean",
          "description": "Opt-in crash reports (stored only; OpenRows sends nothing).",
          "default": false
        }
      }
    },
    "results": {
      "type": "object",
      "description": "Result store; read by the core at launch.",
      "properties": {
        "memoryBudgetMb": {
          "type": "integer",
          "minimum": 64,
          "maximum": 65536,
          "default": 512,
          "description": "Arrow memory kept in RAM across results before spilling to disk, in MiB; applies at the next launch."
        }
      }
    },
    "snippets": {
      "type": "object",
      "description": "Settings ▸ Snippets: SQL snippets offered by completion and Insert Snippet….",
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 500,
          "description": "User snippets.",
          "items": {
            "$ref": "#/definitions/snippet"
          }
        },
        "disabledBuiltins": {
          "type": "array",
          "description": "Ids of built-in snippets that are turned off.",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "export": {
      "type": "object",
      "description": "Export sheet: the last-used format and the options of every format.",
      "properties": {
        "format": {
          "enum": [
            "csv",
            "tsv",
            "json",
            "ndjson",
            "sql",
            "markdown",
            "xlsx",
            "parquet"
          ],
          "default": "csv",
          "description": "Format chosen last."
        },
        "csv": {
          "type": "object",
          "description": "CSV options.",
          "properties": {
            "delimiter": {
              "enum": ["comma", "semicolon", "tab", "pipe"],
              "default": "comma",
              "description": "Field separator."
            },
            "quote": {
              "enum": ["double", "single"],
              "default": "double",
              "description": "Quote character; it is doubled inside quoted fields."
            },
            "header": {
              "type": "boolean",
              "default": true,
              "description": "Write the column names as the first row."
            },
            "nullText": {
              "type": "string",
              "maxLength": 32,
              "default": "",
              "description": "Text written for NULL; empty writes an empty field and quotes empty strings."
            },
            "lineEnding": {
              "enum": ["crlf", "lf"],
              "default": "crlf",
              "description": "Record separator."
            },
            "encoding": {
              "enum": ["utf8", "utf8Bom", "utf16Le", "latin1"],
              "default": "utf8",
              "description": "File encoding; utf8Bom lets Excel detect UTF-8."
            }
          }
        },
        "tsv": {
          "type": "object",
          "description": "TSV options.",
          "properties": {
            "quote": {
              "enum": ["double", "single"],
              "default": "double",
              "description": "Quote character; it is doubled inside quoted fields."
            },
            "header": {
              "type": "boolean",
              "default": true,
              "description": "Write the column names as the first row."
            },
            "nullText": {
              "type": "string",
              "maxLength": 32,
              "default": "",
              "description": "Text written for NULL; empty writes an empty field and quotes empty strings."
            },
            "lineEnding": {
              "enum": ["crlf", "lf"],
              "default": "crlf",
              "description": "Record separator."
            },
            "encoding": {
              "enum": ["utf8", "utf8Bom", "utf16Le", "latin1"],
              "default": "utf8",
              "description": "File encoding; utf8Bom lets Excel detect UTF-8."
            }
          }
        },
        "json": {
          "type": "object",
          "description": "JSON options.",
          "properties": {
            "pretty": {
              "type": "boolean",
              "default": false,
              "description": "Indent objects by two spaces instead of one compact object per line."
            }
          }
        },
        "sql": {
          "type": "object",
          "description": "SQL INSERT options.",
          "properties": {
            "rowsPerStatement": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 100,
              "description": "Rows per INSERT statement."
            }
          }
        },
        "xlsx": {
          "type": "object",
          "description": "Excel options.",
          "properties": {
            "header": {
              "type": "boolean",
              "default": true,
              "description": "Write the column names as a bold first row of every sheet."
            }
          }
        },
        "parquet": {
          "type": "object",
          "description": "Parquet options.",
          "properties": {
            "compression": {
              "enum": ["snappy", "none"],
              "default": "snappy",
              "description": "Column compression (pure-Rust codecs only)."
            }
          }
        }
      }
    },
    "copy": {
      "type": "object",
      "description": "Settings ▸ General ▸ Copy: defaults of plain (tab-separated) and CSV copies from grids.",
      "properties": {
        "headers": {
          "enum": ["format", "always", "never"],
          "default": "format",
          "description": "Start copies with the column names: CSV only (format), always or never."
        },
        "nulls": {
          "enum": ["format", "text", "empty"],
          "default": "format",
          "description": "SQL NULL as NULL in plain copies and empty in CSV (format), always NULL, or always empty."
        },
        "quote": {
          "enum": ["minimal", "all"],
          "default": "minimal",
          "description": "Quote only values that need it, or every value."
        }
      }
    },
    "tools": {
      "type": "object",
      "description": "Settings ▸ Tools: database client and cloud route helpers.",
      "properties": {
        "pgDump": {
          "type": "string",
          "maxLength": 1024,
          "default": "",
          "description": "Path of pg_dump; empty finds the installed copy that best matches the server."
        },
        "pgRestore": {
          "type": "string",
          "maxLength": 1024,
          "default": "",
          "description": "Path of pg_restore; empty finds the installed copy that best matches the server."
        },
        "psql": {
          "type": "string",
          "maxLength": 1024,
          "default": "",
          "description": "Path of psql; empty finds the installed copy that best matches the server."
        },
        "mysqldump": {
          "type": "string",
          "maxLength": 1024,
          "default": "",
          "description": "Path of mysqldump or mariadb-dump; empty finds the installed copy that best matches the server."
        },
        "mysql": {
          "type": "string",
          "maxLength": 1024,
          "default": "",
          "description": "Path of mysql or mariadb; empty finds the installed copy that best matches the server."
        },
        "aws": {
          "type": "string",
          "default": "",
          "maxLength": 1024,
          "description": "Path of aws; empty discovers an installed copy."
        },
        "sessionManagerPlugin": {
          "type": "string",
          "default": "",
          "maxLength": 1024,
          "description": "Path of session-manager-plugin; empty discovers an installed copy."
        },
        "kubectl": {
          "type": "string",
          "default": "",
          "maxLength": 1024,
          "description": "Path of kubectl; empty discovers an installed copy."
        },
        "cloudSqlProxy": {
          "type": "string",
          "default": "",
          "maxLength": 1024,
          "description": "Path of cloud-sql-proxy; empty discovers an installed copy."
        },
        "alloydbAuthProxy": {
          "type": "string",
          "default": "",
          "maxLength": 1024,
          "description": "Path of alloydb-auth-proxy; empty discovers an installed copy."
        },
        "cloudflared": {
          "type": "string",
          "default": "",
          "maxLength": 1024,
          "description": "Path of cloudflared; empty discovers an installed copy."
        }
      }
    }
  },
  "definitions": {
    "snippet": {
      "type": "object",
      "required": ["name", "prefix", "body"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable id; made by the app when missing."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_$]{1,32}$",
          "description": "Typed trigger that offers the snippet in completion."
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "description": "SQL with tab stops such as ${1:name}."
        },
        "scope": {
          "enum": ["all", "postgres", "mysql", "sqlite"],
          "default": "all",
          "description": "Engines the snippet is offered for; MariaDB uses mysql."
        }
      }
    },
    "half": {
      "type": "object",
      "required": ["canvas", "accent"],
      "properties": {
        "canvas": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "theme": {
      "type": "object",
      "required": ["id", "name", "light", "dark"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^custom-[A-Za-z0-9_-]{1,80}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "light": {
          "$ref": "#/definitions/half"
        },
        "dark": {
          "$ref": "#/definitions/half"
        }
      }
    }
  }
}
