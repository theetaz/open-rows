{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRows",
  "version": "0.1.0",
  "identifier": "com.prabhavalabs.openrows",
  "build": {
    "beforeDevCommand": "bash ../../scripts/stage-host.sh dev && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bash ../../scripts/stage-host.sh release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenRows",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "transparent": true,
        "shadow": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 26
        },
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; worker-src 'self' blob:; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/openrows-driver-host"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "fileAssociations": [
      {
        "ext": ["sqlite", "sqlite3", "db"],
        "name": "SQLite database",
        "role": "Viewer"
      },
      {
        "ext": ["duckdb"],
        "name": "DuckDB database",
        "role": "Viewer"
      },
      {
        "ext": ["sql"],
        "name": "SQL document",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "openrowsUpdates": {
      "stable": null,
      "beta": null,
      "publicKey": null
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
