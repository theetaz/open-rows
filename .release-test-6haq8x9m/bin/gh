#!/Applications/Xcode.app/Contents/Developer/usr/bin/python3
import os, sys
from pathlib import Path
if sys.argv[2] == "view":
    if os.environ["RELEASE_STATE"] == "missing":
        sys.exit(1)
    if "--json" in sys.argv:
        print(os.environ["RELEASE_STATE"])
else:
    Path(os.environ["STUB_LOG"]).write_text("created")
