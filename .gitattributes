# Normalise line endings in the repository; check out with LF everywhere.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.sqlite binary
*.db binary
*.duckdb binary
*.parquet binary
*.arrow binary

# Generated files: collapse in diffs.
packages/ipc/src/generated/** linguist-generated=true
Cargo.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
