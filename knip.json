{
  "workspaces": {
    ".": {
      "project": ["*.ts"]
    },
    "apps/desktop": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/ipc": {
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": [
        "src/**/*.test.{ts,tsx}",
        "scripts/{generate-tokens,check-colours,contrast-report,bundle-size}.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/*.ts"]
    },
    "packages/grid": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
